# ==============================================================================
# VARIÁVEIS DE AMBIENTE - EASYPANEL
# ==============================================================================
# Configure estas variáveis diretamente na aba "Environment" do Easypanel.
# NÃO comite dados reais neste arquivo!
# O servidor NÃO sobe se alguma variável obrigatória estiver faltando.

PORT=8000
HOST=0.0.0.0

# [OBRIGATÓRIO] Token para autenticar no endpoint /mcp (URL: https://<dominio>/mcp?token=<MCP_TOKEN>)
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=SEU_TOKEN_SECRETO_AQUI

# [OBRIGATÓRIO] Evolution API v2
EVOLUTION_API_URL=https://sua-evolution.suaempresa.com.br
EVOLUTION_API_KEY=SUA_API_KEY_AQUI
EVOLUTION_INSTANCE=Nome da Instancia

# Fuso horário dos agendamentos (padrão: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo

# Diretório para armazenamento da fila de agendamentos
DATA_DIR=/data

# Cadastro Dinâmico dos Accounts (Edite diretamente no Easypanel)
ACCOUNTS=[{"id":"1","name":"Account 1","phone":"5511999999999","role":"Account Manager","aliases":["account1"]},{"id":"2","name":"Account 2","phone":"5511888888888","role":"Account Manager","aliases":["account2"]}]
