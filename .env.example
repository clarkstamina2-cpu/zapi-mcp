# ==============================================================================
# VARIÁVEIS DE AMBIENTE - EASYPANEL
# ==============================================================================
# Configure estas variáveis diretamente na aba "Environment" do Easypanel.
# NÃO comite dados reais neste arquivo!

PORT=8000
HOST=0.0.0.0

# Credenciais da Z-API (preencha no painel do Easypanel)
ZAPI_INSTANCE_ID=SUA_INSTANCIA_AQUI
ZAPI_TOKEN=SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN_AQUI

# Diretório para armazenamento da fila de agendamentos
DATA_DIR=/data

# Cadastro Dinâmico dos Accounts (Edite diretamente no Easypanel)
ACCOUNTS=[{"id":"1","name":"Account 1","phone":"5511999999999","role":"Account Manager","aliases":["account1"]},{"id":"2","name":"Account 2","phone":"5511888888888","role":"Account Manager","aliases":["account2"]}]
